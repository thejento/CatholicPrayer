<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (ADR-034): these versions can't tell a cloud backup
     from a device transfer for every release, so neither carries the settings
     or the prayer journal. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
